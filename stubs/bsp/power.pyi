"""Power rails, LED and battery latch on the TCA9554 expander. No argument: read back."""

from typing import overload

@overload
def epd() -> bool: ...
@overload
def epd(on: bool) -> None: ...
@overload
def audio() -> bool: ...
@overload
def audio(on: bool) -> None: ...
@overload
def vbat_latch() -> bool: ...
@overload
def vbat_latch(on: bool) -> None: ...
@overload
def led() -> bool: ...
@overload
def led(on: bool) -> None: ...
