 # Generate qstrs
 
+# Response files for the preprocessor flags and the qstr source list: passed inline
+# they exceed the Windows command line limit (32K chars) for the esp32 port.
+set(MICROPY_CPP_FLAGS_RSP ${MICROPY_GENHDR_DIR}/cpp_flags.rsp)
+set(MICROPY_SOURCE_QSTR_RSP ${MICROPY_GENHDR_DIR}/source_qstr.rsp)
+set(_rsp "")
+foreach(_arg IN LISTS MICROPY_CPP_FLAGS)
+    string(REPLACE "\\" "\\\\" _arg "${_arg}")
+    string(REPLACE "\"" "\\\"" _arg "${_arg}")
+    string(APPEND _rsp "${_arg}\n")
+endforeach()
+file(GENERATE OUTPUT ${MICROPY_CPP_FLAGS_RSP} CONTENT "${_rsp}")
+string(REPLACE ";" "\n" _rsp "${MICROPY_SOURCE_QSTR}")
+file(GENERATE OUTPUT ${MICROPY_SOURCE_QSTR_RSP} CONTENT "${_rsp}\n")
+
