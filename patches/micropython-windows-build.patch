index 0000000..55206c2
--- /dev/null
+++ b/py/makeqstrpp.py
@@ -0,0 +1,31 @@
+"""
+Portable replacement for the shell pipeline that preprocesses the qstr definitions:
+
+    cat INPUTS... | sed 's/^Q(.*)/"&"/' | CC -E FLAGS - | sed 's/^"\(Q(.*)\)"/\1/' > OUTPUT
+
+Usage: makeqstrpp.py CC @FLAGS_RSP OUTPUT INPUTS...
+"""
+
+import re
+import subprocess
+import sys
+
+
+def main():
+    cc, flags, output = sys.argv[1:4]
+    text = ""
+    for name in sys.argv[4:]:
+        with open(name, encoding="utf-8") as f:
+            text += f.read()
+    # Quote the Q(...) lines so the preprocessor leaves their contents alone.
+    text = re.sub(r"^Q\(.*\)", lambda m: '"' + m.group(0) + '"', text, flags=re.M)
+    result = subprocess.run([cc, "-E", flags, "-"], input=text.encode("utf-8"), stdout=subprocess.PIPE)
+    if result.returncode:
+        sys.exit(result.returncode)
+    text = re.sub(r'^"(Q\(.*\))"', r"\1", result.stdout.decode("utf-8"), flags=re.M)
+    with open(output, "w", encoding="utf-8", newline="\n") as f:
+        f.write(text)
+
+
+if __name__ == "__main__":
+    main()
